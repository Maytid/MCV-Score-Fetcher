{
  "manifest_version": 3,
  "name": "MCV Score Fetcher",
  "version": "1.0.4",
  "description": "Fetch scores for all courses within the current semester.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "main.html",
    "default_icon": "./mcv_fetcher_icon.png"
  },
  "icons": {
    "128": "./mcv_fetcher_icon.png"
  },
  "host_permissions": [
    "*://www.mycourseville.com/*"
  ]
}